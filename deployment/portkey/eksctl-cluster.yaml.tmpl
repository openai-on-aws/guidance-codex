apiVersion: eksctl.io/v1alpha5
kind: ClusterConfig
metadata:
  name: __CLUSTER_NAME__
  region: us-east-1
  version: "1.32"
iam:
  withOIDC: true
managedNodeGroups:
  - name: portkey-gateway
    instanceType: t4g.medium
    desiredCapacity: 2
    minSize: 2
    maxSize: 4
    privateNetworking: true
    volumeSize: 30
    volumeEncrypted: true
    labels:
      workload: portkey-gateway
    tags:
      Application: guidance-codex-portkey
