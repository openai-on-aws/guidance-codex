# Copy to .env.deploy. The real file is ignored.
# Fixed validation target: hosted Portkey -> Bedrock Mantle in us-east-1.
AWS_REGION=us-east-1
PORTKEY_STACK_NAME=codex-portkey-bedrock-mantle
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Supplied by Portkey for hosted assumed-role integrations. Generate a unique
# external ID of at least 16 characters. Neither value is printed by the helper.
PORTKEY_AWS_PRINCIPAL_ARN=
PORTKEY_EXTERNAL_ID=

# After deploying the role, create a Bedrock Mantle provider in Model Catalog
# and record its slug without the leading @.
PORTKEY_PROVIDER_SLUG=
PORTKEY_MODEL=@replace-with-provider-slug/openai.gpt-5.5
PORTKEY_API_KEY=

# Start with * so Portkey can resolve the account's Mantle project. After the
# live run, replace this with the proj_... ID observed in CloudTrail and deploy
# again to tighten the role.
BEDROCK_MANTLE_PROJECT_ID=*

# Optional AWS CLI profile.
# AWS_PROFILE=your-sandbox-profile
