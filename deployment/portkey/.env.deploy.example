# Copy to .env.deploy. The real file is ignored. This deploys the Portkey
# Hybrid data plane to EKS; Portkey supplies the licensed images/control plane.
# AWS_REGION owns EKS, S3 logs, CloudFormation, and load-balancer resources.
AWS_REGION=us-east-1
# BEDROCK_MANTLE_REGION owns the Mantle provider endpoint and IAM condition. It
# may differ from AWS_REGION but must be an AWS-documented Mantle region. Use a
# separate Portkey provider for each Mantle region. The checked-in offline tests
# use us-east-1 as the default target.
# A concurrent second region also needs isolated deployment identifiers: use a
# unique stack and cluster, or on an existing shared cluster use a unique stack,
# namespace, service account, and Helm release plus a pre-existing compatible
# load-balancer controller that watches all namespaces. Reusing this stack
# updates its regional/model IAM scope; it does not add another region.
BEDROCK_MANTLE_REGION=us-east-1
PORTKEY_CLUSTER_NAME=codex-portkey
PORTKEY_NAMESPACE=portkeyai
PORTKEY_SERVICE_ACCOUNT=gateway-sa
PORTKEY_STACK_NAME=codex-portkey-hybrid
PORTKEY_HELM_RELEASE=portkey-ai
# Helm CLI 3 is required (the CI/reference version is 3.21.4). Helm 4 changes
# --post-renderer to plugin semantics and is not supported by this workflow.
# Treat the stack, namespace/service-account, and Helm-release names as
# exclusive to this deployment. The helper never adopts a same-named gateway
# service account: it creates one only when both the account and its
# deterministic eksctl IAM stack are absent, and permits a rerun only after
# proving that the existing pair belongs to this deployment. A partial,
# unmanaged, drifted, or unreadable pair fails before any deployment write.
# Same-named CloudFormation stacks and Helm releases can still be updated, so
# resolve those collisions with their owners before deployment or cleanup.
PORTKEY_HELM_CHART_VERSION=1.7.7
# Version-matched to lbc-iam-policy.json.tmpl; do not change independently.
PORTKEY_LBC_HELM_CHART_VERSION=3.4.2
# eksctl 0.229.0 or newer is required generally. Exact 0.229.0 is required at
# cluster-deploy's pre-write gate and when lbc-deploy will create or update this
# workflow's walkthrough-managed controller IAM stack. External controller
# reuse and status/cleanup flows do not require the exact pin.
# Required: this walkthrough only creates an internal NLB; it never creates an
# internet-facing or world-open listener. Redis is ClusterIP-only; the gateway
# is the sole LoadBalancer and disables NodePort allocation. A verified legacy
# gateway NodePort is removed only during a confirmed Helm deployment.
PORTKEY_INTERNAL_NLB=true

# Required for Helm plan/deploy. These resources are customer-owned and must
# already exist; this workflow does not create or delete them. The certificate
# must be ISSUED in this AWS account and AWS_REGION, and its SAN must cover the
# hostname. Private-CA certificates also require trust on every Codex client.
PORTKEY_GATEWAY_HOSTNAME=
PORTKEY_NLB_TLS_CERTIFICATE_ARN=
# One or more comma-separated, active, customer-managed IPv4 prefix-list IDs
# in this AWS account and AWS_REGION. Do not include whitespace or any entries
# that individually or together cover all IPv4 addresses. The sum of their
# MaxEntries values must be <=60; AWS charges MaxEntries, not the current entry
# count, against the frontend security group's rule quota. Prefix-list contents
# remain mutable, so protect them with normal network change control.
PORTKEY_NLB_ALLOWED_PREFIX_LIST_IDS=
# For a reviewed certificate-ARN or prefix-list-ID rotation, pass
# CONFIRM_PORTKEY_NLB_TLS_UPDATE=<namespace>/<helm-release>-gateway only on the
# individual helm-deploy command. Never persist that confirmation in this file.
# Likewise, pass PORTKEY_EXTERNAL_LBC_POLICY_CONFIRMED=true only on each
# lbc-deploy, lbc-status, or helm-deploy command that reuses an externally
# managed controller. Never add that owner attestation to this file.

# Supplied or approved for this deployment. Never commit the populated file.
# Pair each version tag with its exact sha256:<64-lowercase-hex> registry
# digest. The digest, not the tag, identifies the deployed content; digest
# pinning does not verify a publisher signature. The helper validates syntax
# but does not resolve private registry tags, so approve each matching pair
# out-of-band. The included t4g nodes require
# a multi-architecture image index containing linux/arm64 or a compatible
# linux/arm64 manifest. Existing environment files without both digests fail
# before Helm changes Kubernetes. To roll back, restore a previously approved
# tag/digest pair and redeploy instead of selecting a pre-digest Helm revision.
# Worker nodes must pull the hard-coded gateway and Redis repositories from
# Docker Hub. An approved mirror requires a reviewed template customization;
# this environment file does not expose repository overrides.
PORTKEY_DOCKER_USERNAME=
PORTKEY_DOCKER_PASSWORD=
PORTKEY_CLIENT_AUTH=
PORTKEY_ORGANIZATION_ID=
PORTKEY_GATEWAY_IMAGE_TAG=
PORTKEY_GATEWAY_IMAGE_DIGEST=
PORTKEY_REDIS_IMAGE_TAG=
PORTKEY_REDIS_IMAGE_DIGEST=

# In restricted-egress clusters, separately allow pod HTTPS access to Portkey
# api/albus, AWS STS, regional S3 in AWS_REGION, and Bedrock Mantle in
# BEDROCK_MANTLE_REGION. Use NAT or service-specific VPC endpoints where the
# service and region support them; Portkey outbound PrivateLink is a separate
# vendor-assisted customization.

# Create a Bedrock Mantle provider in Model Catalog using Service Role (EKS /
# IRSA), in BEDROCK_MANTLE_REGION. Record its slug without the leading @.
# Preflight checks slug syntax only; confirm the provider region in Portkey and
# prove it with live CloudTrail CreateInference evidence.
PORTKEY_PROVIDER_SLUG=
# Comma-separated bare Mantle model IDs. Each entry is IAM-allowed and must
# pass the strict Responses probe. openai.gpt-5.5 is the tested default target.
PORTKEY_ALLOWED_MODELS=openai.gpt-5.5
# Select exactly one allowlisted model for the real Codex exec. No fallback is
# attempted if this provider/model pair is unavailable.
PORTKEY_MODEL=@replace-with-provider-slug/openai.gpt-5.5
PORTKEY_API_KEY=

# For durable use, this must be
# https://<PORTKEY_GATEWAY_HOSTNAME>/v1 (with no query, fragment, credentials,
# or non-443 port). Private DNS must map that hostname to the internal NLB.
# Leave blank only to validate through the temporary local kubectl
# port-forward; Helm still requires the hostname, certificate, and prefix-list
# inputs above.
PORTKEY_BASE_URL=

# Start with * so Portkey can resolve the account's Mantle project. After the
# live run, replace this with the proj_... ID observed in CloudTrail, or
# "default" when no OpenAI-Project header was supplied, and deploy again.
BEDROCK_MANTLE_PROJECT_ID=*

# Optional AWS CLI profile and kubeconfig path.
# AWS_PROFILE=your-sandbox-profile
# KUBECONFIG=/path/to/kubeconfig
