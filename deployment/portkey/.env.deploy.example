# Copy to .env.deploy. The real file is ignored. This deploys the Portkey
# Hybrid data plane to EKS; Portkey supplies the licensed images/control plane.
AWS_REGION=us-east-1
PORTKEY_CLUSTER_NAME=codex-portkey
PORTKEY_NAMESPACE=portkeyai
PORTKEY_SERVICE_ACCOUNT=gateway-sa
PORTKEY_STACK_NAME=codex-portkey-hybrid
PORTKEY_HELM_RELEASE=portkey-ai
PORTKEY_HELM_CHART_VERSION=1.7.7
PORTKEY_INTERNAL_NLB=true

# Supplied by Portkey Enterprise. Never commit the populated file.
PORTKEY_DOCKER_USERNAME=
PORTKEY_DOCKER_PASSWORD=
PORTKEY_CLIENT_AUTH=
PORTKEY_ORGANIZATION_ID=
PORTKEY_GATEWAY_IMAGE_TAG=
PORTKEY_REDIS_IMAGE_TAG=

# Create a Bedrock Mantle provider in Model Catalog using Service Role (EKS /
# IRSA), region us-east-1. Record the provider slug without the leading @.
PORTKEY_PROVIDER_SLUG=
PORTKEY_MODEL=@replace-with-provider-slug/openai.gpt-5.5
PORTKEY_API_KEY=

# Set after deployment to the AWS load-balancer URL, including /v1. Leave blank
# to use kubectl port-forward for validation.
PORTKEY_BASE_URL=

# Start with * so Portkey can resolve the account's Mantle project. After the
# live run, replace this with the proj_... ID observed in CloudTrail and deploy
# again to tighten the role.
BEDROCK_MANTLE_PROJECT_ID=*

# Optional AWS CLI profile and kubeconfig path.
# AWS_PROFILE=your-sandbox-profile
# KUBECONFIG=/path/to/kubeconfig
