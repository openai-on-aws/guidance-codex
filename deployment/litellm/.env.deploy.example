# Copy to deployment/litellm/.env.deploy and fill in the required values.
# The real file is gitignored. Do not put long-lived AWS access keys here.

AWS_PROFILE=mccartni-codex
AWS_REGION=us-east-1
BEDROCK_REGION=us-east-1

# LiteLLM v1.94.0, pinned to the reviewed GHCR manifest digest.
LITELLM_BASE_IMAGE=ghcr.io/berriai/litellm@sha256:65d84a2282137b4dc73bbe184650a7c807177c533e4223b3bfbc87963fe3fabe

# HTTPS is mandatory for staging and production. Set a Route 53 zone ID to
# create and validate a managed ACM certificate, or provide an existing one.
ENABLE_TLS=true
GATEWAY_DOMAIN_NAME=gateway.example.com
ROUTE53_HOSTED_ZONE_ID=Z0123456789EXAMPLE
ALB_CERTIFICATE_ARN=
ALLOWED_CIDR=203.0.113.10/32
# Optional additional browser, VPN, or terminal egress addresses. Keep these
# blank unless needed, and prefer exact /32 entries for walkthroughs.
ADDITIONAL_ALLOWED_CIDR_1=
ADDITIONAL_ALLOWED_CIDR_2=

# Optional naming and sizing overrides.
NETWORKING_STACK=codex-networking
GATEWAY_STACK=codex-litellm-gateway
LITELLM_REPO=codex-litellm
BUILDX_BUILDER=codex-builder

# Optional: export an existing VPC and two public subnets instead of creating
# another VPC. Supply all three values or leave all three blank.
EXISTING_VPC_ID=
EXISTING_PUBLIC_SUBNET_1=
EXISTING_PUBLIC_SUBNET_2=

DESIRED_COUNT=1
MIN_TASK_COUNT=1
MAX_TASK_COUNT=2
ENABLE_WAF=true
DB_MULTI_AZ=true

# Optional scoped-key identity and limits used by make litellm-provision-key.
CODEX_KEY_ALIAS=codex-walkthrough
CODEX_KEY_MODELS=gpt-5.5
CODEX_KEY_USER_ID=
CODEX_KEY_TEAM_ID=
CODEX_KEY_MAX_BUDGET=
CODEX_KEY_BUDGET_DURATION=
CODEX_KEY_TPM_LIMIT=
CODEX_KEY_RPM_LIMIT=
