# Copy to .env.deploy. The real file is ignored.
AWS_PROFILE=default
AWS_REGION=us-east-1
IDC_REGION=us-east-1

STACK_NAME=codex-bedrock-idc-validation
POLICY_NAME=CodexBedrockValidationInvokePolicy
PERMISSION_SET_NAME=CodexBedrockValidation
GROUP_NAME=Codex-Bedrock-Validation

# Existing IAM Identity Center username to add to the isolated validation group.
IDC_USER_NAME=

# Find this in IAM Identity Center > Settings > AWS access portal URL.
IDC_START_URL=
IDC_CLIENT_PROFILE=codex-bedrock-validation
SESSION_DURATION=PT8H

ALLOWED_BEDROCK_REGIONS=us-east-1
ALLOWED_MODEL_ID_PATTERN=openai.gpt-*
BEDROCK_TEST_MODEL=openai.gpt-oss-120b-1:0
CODEX_MODEL=openai.gpt-5.5
RUN_CODEX_VALIDATION=false
